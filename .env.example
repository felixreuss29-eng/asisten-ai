# ============================================================
# KONFIGURASI ASISTEN AI
# Salin file ini menjadi .env lalu pilih salah satu provider.
# Kunci API hanya dibaca server, TIDAK pernah dikirim ke browser.
# ============================================================

PORT=3000

# ------------------------------------------------------------
# PILIHAN 1 — Ollama lokal (DEFAULT, GRATIS, tanpa API key asli)
#   1. Install Ollama: https://ollama.com/download
#   2. jalankan: ollama pull qwen2.5:7b-instruct
#   3. jalankan: ollama serve
# API key bebas diisi "ollama" karena Ollama lokal tidak memeriksa key.
# ------------------------------------------------------------
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b-instruct

# ------------------------------------------------------------
# PILIHAN 2 — Groq (cepant, model open source, ada free tier)
#   Hapus "#" di tiga baris di bawah DAN beri "#" di tiga baris Ollama.
# ------------------------------------------------------------
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_api_key_kamu_di_sini
# LLM_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------
# PILIHAN 3 — OpenRouter (banyak model open source, ada free tier)
# ------------------------------------------------------------
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-api_key_kamu_di_sini
# LLM_MODEL=qwen/qwen-2.5-72b-instruct:free

# ============================================================
# PENGATURAN OPSIONAL
# ============================================================

# Mesin pencari untuk tool cari_web: ddg atau searx
SEARCH_ENGINE=ddg

# Isi hanya jika SEARCH_ENGINE=searx dan memakai instance SearXNG sendiri
SEARXNG_URL=

# Lokasi database SQLite (relatif terhadap folder proyek)
SQLITE_FILE=./data/asisten.db

# Batas permintaan per menit per alamat IP
RATE_LIMIT=30
